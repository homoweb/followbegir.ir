APP_NAME=FollowBegir
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://followbegir.test

APP_LOCALE=fa
APP_FALLBACK_LOCALE=fa
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=followbegir
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Must match the shared parent domain so the session cookie works on
# followbegir.test, panel.followbegir.test and admin.followbegir.test
SESSION_DOMAIN=.followbegir.test

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --------------------------------------------------------------------------
# FollowBegir domains (dev: *.test / production: followbegir.ir)
# --------------------------------------------------------------------------
FB_SCHEME=https
FB_MAIN_DOMAIN=followbegir.test
FB_PANEL_DOMAIN=panel.followbegir.test
FB_ADMIN_DOMAIN=admin.followbegir.test
# FB_MAIN_URL=https://followbegir.ir
# FB_PANEL_URL=https://panel.followbegir.ir
# FB_ADMIN_URL=https://admin.followbegir.ir

# --------------------------------------------------------------------------
# Payment gateway (shetabit/payment)
# local = built-in fake gateway for local testing, zarinpal = production
# --------------------------------------------------------------------------
PAYMENT_DRIVER=local
ZARINPAL_MERCHANT_ID=
PAYMENT_CALLBACK_URL=

# --------------------------------------------------------------------------
# Initial admin account (created by database seeder)
# --------------------------------------------------------------------------
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@followbegir.ir
ADMIN_PASSWORD=

